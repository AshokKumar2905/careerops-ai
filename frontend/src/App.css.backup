#root {
  min-height: 100vh;
}

body {
  background:
    radial-gradient(circle at 15% 10%, rgba(34, 211, 238, 0.08), transparent 28%),
    radial-gradient(circle at 85% 35%, rgba(139, 92, 246, 0.08), transparent 30%),
    #050505;
}

main {
  position: relative;
  isolation: isolate;
}

main::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  opacity: 0.18;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
  background-size: 48px 48px;
  mask-image: linear-gradient(to bottom, black, transparent 80%);
}

header {
  backdrop-filter: blur(18px);
}

section {
  position: relative;
}

section:first-of-type {
  min-height: 620px;
  display: flex;
  align-items: center;
}

section:first-of-type h2 {
  letter-spacing: -0.045em;
  text-shadow: 0 0 50px rgba(34, 211, 238, 0.12);
}

section:first-of-type a,
section article,
section span {
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background-color 180ms ease,
    box-shadow 180ms ease;
}

section:first-of-type a:hover {
  transform: translateY(-2px);
}

section article:hover {
  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.35);
}

section span:hover {
  transform: translateY(-2px);
  border-color: rgba(34, 211, 238, 0.35);
  background: rgba(34, 211, 238, 0.05);
}

footer {
  background: rgba(255, 255, 255, 0.015);
}

@media (max-width: 640px) {
  section:first-of-type {
    min-height: auto;
  }

  section:first-of-type h2 {
    letter-spacing: -0.03em;
  }
}
